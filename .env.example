# Runtime location
TRADE_BOT_HOME=/app
BOT_STATE_FILE=bot_state.json

# Binance testnet credentials for live mode
BINANCE_API_KEY=your_testnet_key_here
BINANCE_API_SECRET=your_testnet_secret_here

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime tuning
BOT_LOOP_SLEEP_SECONDS=60
BOT_STARTING_BALANCE=50.0
BOT_OPERATING_MODE=paper
BOT_NEWS_ENGINE_ENABLED=true
BOT_NEWS_POLL_INTERVAL_MINUTES=15
BOT_USE_TESTNET_PUBLIC=true
